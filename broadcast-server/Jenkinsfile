
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                bat 'cd broadcast-server && mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'cd broadcast-server && mvn test'
            }
        }

        stage('Package') {
            steps {
                bat 'cd broadcast-server && mvn package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t broadcast-server:1.0 broadcast-server'
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'broadcast-server/target/surefire-reports/*.xml',
                allowEmptyResults: true
            )
        }

        success {
            archiveArtifacts artifacts: 'broadcast-server/target/*.jar',
                             fingerprint: true
        }
    }
}
