pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                bat 'cd broadcast-server && mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'cd broadcast-server && mvn test'
            }
        }

        stage('Package') {
            steps {
                bat 'cd broadcast-server && mvn package -DskipTests'
            }
        }
    }

    post {
        always {
            junit 'broadcast-server/target/surefire-reports/*.xml'
        }

        success {
            archiveArtifacts artifacts: 'broadcast-server/target/*.jar'
        }
    }
}