pipeline{
agent any
stages{
stage('build'){
steps{
 bat 'cd broadcast-server && mvn clean package'
}
stage('Test'){
steps{
 bat 'mvn test'
}
}
stage('Package'){
steps{
bat 'mvn package -DskipTests'
}

}
}
}
}
post{
  always{
  junit 'target/surefire-report/*.xml'

  }

  success {
     archiveArtifacts artifacts: 'target/*.jar'

  }

}